rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read: these render via plain <img src>, which carries no
    // Firebase auth token at all, so a read rule requiring auth blocks
    // every image for everyone, uploader included. Write stays locked
    // to the owning device.
    match /photos/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /signatures/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    // Official gallery — public read (plain <img>/<video> tags), no
    // client write path at all. Uploaded only via an authenticated
    // admin script, which bypasses Storage rules the same way the
    // Firebase Console does.
    match /gallery/{day}/{fileName} {
      allow read: if true;
      allow write: if false;
    }
  }
}
